# ---- Database (required) ----
# MongoDB connection string. A free MongoDB Atlas cluster works well.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ---- Auth (required) ----
# Secret used to sign JWTs. Use a long, random string (e.g. `openssl rand -base64 48`).
JWT_SECRET=replace-with-a-long-random-secret
# Token lifetime (any value the `jose`/ms format accepts, e.g. 6h, 7d).
JWT_EXPIRES_IN=7d

# ---- Server ----
PORT=3000

# ---- Geocoding (OpenStreetMap Nominatim) ----
# Base URL of the geocoding provider.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim rejects stock User-Agents. App name is fine; add a contact in your local .env.
GEOCODER_USER_AGENT=MyGeoLife/1.0
# Preferred result languages (Accept-Language), comma-separated.
GEOCODER_LANGUAGE=he,en
